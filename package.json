{
  "name": "llwa-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Adaptive AI language tutor - Telegram Mini App + Serverless Edge backend",
  "workspaces": [
    "apps/*",
    "workers/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @llwa/web",
    "dev:edge": "npm run dev -w @llwa/edge",
    "build": "npm run build -w @llwa/shared && npm run build -w @llwa/edge && npm run build -w @llwa/web",
    "build:shared": "npm run build -w @llwa/shared",
    "build:tma": "npm run build -w @llwa/web",
    "build:edge": "npm run build -w @llwa/edge",
    "deploy:ghpages": "REPO=DashAkoul/llwa bash scripts/deploy-github-pages.sh",
    "deploy:app": "bash scripts/deploy-frontend-worker.sh",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
