# ─────────────────────────────────────────────────────────────────────
#  LLWA public site — headers
#
#  این سایت باید برای بازبین‌های Google قابل خواندن باشد، پس noindex
#  ندارد. هیچ اسکریپت بیرونی بارگذاری نمی‌شود، بنابراین CSP سخت‌گیرانه است.
# ─────────────────────────────────────────────────────────────────────

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Content-Security-Policy: default-src 'self'; script-src 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'none'; frame-ancestors 'self'; base-uri 'self'; form-action 'none'

/styles.css
  Cache-Control: public, max-age=3600

/*.html
  Cache-Control: public, max-age=600, must-revalidate
