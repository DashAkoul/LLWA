# ⚠️ این فایل را کامیت نکنید — مقادیر محلی/توسعه است.
# متغیرهای EXPO_PUBLIC_* در زمان بیلد داخل باندل می‌شوند (نه راز هستند).

# آدرس API (Worker روی ساب‌دامین اختصاصی)
EXPO_PUBLIC_API_BASE=https://api.infolange.ir
EXPO_PUBLIC_GATE_PATH=/llwa74/9xkr2mqv/v1/gate

# ── MVP ─────────────────────────────────────────────────────────────
# true = دکمهٔ ورود بدون گوگل یک کاربر آزمایشی می‌سازد.
# برای انتشار واقعی: false و مقادیر Google را پر کنید.
EXPO_PUBLIC_DEMO_MODE=true

# ── ورود واقعی با گوگل (بعد از ساخت کلاینت‌ها در Google Cloud) ──────
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
