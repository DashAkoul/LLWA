# ═══════════════════════════════════════════════════════════════════════
#  LLWA — environment template
#
#  ⚠️ این فایل نمونه است. مقادیر واقعی را در `.env` (gitignored) یا با
#  `wrangler secret put` بگذارید. هیچ رازی را کامیت نکنید.
# ═══════════════════════════════════════════════════════════════════════

# ── Database (Supabase) ────────────────────────────────────────────────
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Session ────────────────────────────────────────────────────────────
# بسازید با: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# ── Google Sign-In ─────────────────────────────────────────────────────
# سه کلاینت (Web / Android / iOS) با کاما. سرور هر سه را می‌پذیرد.
GOOGLE_CLIENT_IDS=

# ── Admin console ──────────────────────────────────────────────────────
# رمز ورود پنل وب (MVP). در production با SSO جایگزین شود.
ADMIN_PANEL_PASSWORD=
# ایمیل‌هایی که به‌محض ورود SUPER_ADMIN می‌شوند
ADMIN_EMAILS=

# ── MVP فقط ────────────────────────────────────────────────────────────
# true = ورود آزمایشی بدون گوگل. در production باید false باشد.
DEMO_MODE=true

# ── AI providers ───────────────────────────────────────────────────────
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
AI_PRIMARY_MODEL=gemini-3.8-flash
AI_FALLBACK_MODELS=deepseek-chat,claude-3-5-sonnet-latest
# کلید master رمزنگاری کلیدهای پنل ادمین (AES-GCM). اگر عوض شود،
# کلیدهای ذخیره‌شده در پنل غیرقابل خواندن می‌شوند.
PROVIDER_ENCRYPTION_KEY=
# سقف مصرف توکن هر کاربر در ۲۴ ساعت (۰ = بدون سقف)
AI_TOKEN_BUDGET_PER_DAY=300000

# ── Media / TTS ────────────────────────────────────────────────────────
MEDIA_S3_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
MEDIA_S3_BUCKET=kpanah-media
MEDIA_S3_REGION=eu-central-003
MEDIA_S3_KEY_ID=
MEDIA_S3_APP_KEY=
MEDIA_URL_BASE=https://api.infolange.ir/llwa74/9xkr2mqv/v1/media
TTS_PROVIDER=online-tts
TTS_BASE_URL=

# ── Telegram (اختیاری — فقط مسیر ربات) ─────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=
TELEGRAM_WEBHOOK_SECRET=

# ── Queue / background ─────────────────────────────────────────────────
USE_QSTASH=false
BACKGROUND_BUDGET_MS=20000
